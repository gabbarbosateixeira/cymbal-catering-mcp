# ==========================================
# Cymbal Catering Application Configuration
# ==========================================

# 1. Google Cloud Platform (GCP) Configuration
# Required for agent.js when running Gemini integration
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# 2. Database Connection Options
# Used by db.js for connection pool setup.
# If DATABASE_URL is set, it overrides the host/user/password options.
# DATABASE_URL=postgres://user:password@host:port/database

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cymbal
DB_SSL=false

# 3. Application Tuning Configurations
PORT=3001
TAX_RATE=0.085
DEFAULT_DELIVERY_FEE=35.00
